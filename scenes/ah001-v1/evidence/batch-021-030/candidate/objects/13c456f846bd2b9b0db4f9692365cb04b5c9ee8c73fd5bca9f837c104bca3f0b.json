ly in the batch report."},"config":{"artRevision":"ah001-v1","baseCoins":30,"chapter":1,"destination":"Rome","image":"res://assets/art/ah001-v1/021/b5a771a3a8ec-picture.png","levelId":21,"liveLayers":["light"],"mainColour":"#a99451","paintedAnimation":{"background":"res://assets/art/ah001-v1/021/8f715e047832-background.png","parts":[{"amplitude":4,"axis":[1,0],"rect":[0.03046875,0.340625,0.109375,0.08125],"source":"res://assets/art/ah001-v1/021/d741d07e0c59-part-1.png"},{"amplitude":4,"axis":[1,0],"rect":[0.8,0.14125,0.1484375,0.119375],"source":"res://assets/art/ah001-v1/021/20ff83e91d7b-part-2.png"},{"amplitude":4,"axis":[1,0],"rect":[0.1375,0.41375,0.1015625,0.131875],"source":"res://assets/art/ah001-v1/021/62299c3e5728-part-3.png"},{"amplitude":4,"axis":[1,0],"rect":[0.475,0.2725,0.07265625,0.05375],"source":"res://assets/art/ah001-v1/021/19c685e4e44b-part-4.png"},{"amplitude":4,"axis":[1,0],"rect":[0.56953125,0.60375,0.08125,0.0475],"source":"res://assets/art/ah001-v1/021/02e0d4fb2f8a-part-5.png"}],"version":1},"pieces":[{"border":true,"center":[0.124070137739182,0.127352386713028],"detail":0.0363892538357402,"vertices":[[0.0,0.0],[0.219229996204376,0.0],[0.234527006745338,0.033786166459322],[0.240768328309059,0.0679688230156899],[0.248140275478363,0.102101974189281],[0.212764322757721,0.138106793165207],[0.246246963739395,0.171096727252007],[0.234051749110222,0.206086590886116],[0.229769989848137,0.240729987621307],[0.229325622320175,0.244205817580223],[0.226249501109123,0.24443781375885],[0.226448550820351,0.248706683516502],[0.224578604102135,0.25042536854744],[0.223616614937782,0.253263205289841],[0.219804599881172,0.252588212490082],[0.215989992022514,0.251910001039505],[0.18780642747879,0.226805254817009],[0.152947962284088,0.254704773426056],[0.126740291714668,0.213909789919853],[0.0923589542508125,0.238020300865173],[0.059848103672266,0.247277736663818],[0.034682385623455,0.198208853602409],[0.0,0.224709987640381]],"width":0.248140275478363},{"border":t